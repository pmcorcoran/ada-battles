{
  "name": "ada-battles",
  "version": "0.1.0",
  "description": "Multiplayer battle royale game with triangle sprites",
  "main": "src/client/main.ts",
  "scripts": {
    "build:server": "tsc",
    "build:client": "esbuild src/client/main.ts --bundle --outfile=public/bundle.js --format=iife --platform=browser",
    "build": "npm run build:server && npm run build:client",
    "serve": "npx serve -s public -l 3000",
    "start": "npm run build && npm run serve",
    "dev": "npm run build && npm run serve",
    "watch": "esbuild src/client/main.ts --bundle --outfile=public/bundle.js --format=iife --platform=browser --watch"
  },
  "dependencies": {
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "esbuild-plugin-polyfill-node": "^0.3.0",
    "typescript": "^5.3.2"
  }
}
